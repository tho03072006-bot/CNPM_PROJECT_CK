# Copy file nay thanh "application-secrets.properties" (cung cap, KHONG commit len GitHub)
# roi dien thong tin that cua ban vao.

spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=cinema_booking;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=your_sql_password

# Gmail gui OTP dang ky / khoi phuc / thanh toan, xac nhan ve va hoan tien.
# Mat khau la "App Password"
# tao o myaccount.google.com/apppasswords, KHONG phai mat khau dang nhap Gmail.
# De trong thi ung dung van chay, nhung khong hoan tat duoc cac luong can OTP.
spring.mail.username=your_email@gmail.com
spring.mail.password=your_gmail_app_password

# Cong thanh toan MoMo, moi truong thu. Lay bo khoa thu o trang "Thong tin tich hop"
# cua developers.momo.vn. De trong thi chua the thanh toan online (QR/the).
momo.endpoint=https://test-payment.momo.vn
momo.partner-code=
momo.access-key=
momo.secret-key=

# Khoa ky link dat lai mat khau: mot chuoi ngau nhien dai, moi may tu tao.
app.password-reset.secret=doi_thanh_chuoi_ngau_nhien_dai

# Vi MoMo gia lap Nhom 8; dia chi HTTPS cong khai cho dien thoai.
# demo-wallet.enabled=true
# demo-wallet.public-base-url=https://<dia-chi-demo>
