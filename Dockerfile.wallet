# Build chi tu ma nguon; khong copy file secret/database/runtime cua may local.
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre-jammy
RUN groupadd --gid 10001 wallet && useradd --uid 10001 --gid wallet --no-create-home wallet
WORKDIR /app
COPY --from=build --chown=wallet:wallet /build/target/cinema-booking-0.0.1-SNAPSHOT.jar /app/wallet.jar
USER wallet
ENV SPRING_PROFILES_ACTIVE=wallet-online
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=55.0 -XX:InitialRAMPercentage=10.0 -Xss512k -XX:+ExitOnOutOfMemoryError -Dsun.net.httpserver.maxReqTime=15 -Dsun.net.httpserver.maxRspTime=15"
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "/app/wallet.jar"]
