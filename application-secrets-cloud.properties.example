# Copy file nay thanh "application-secrets-cloud.properties" (cung cap, KHONG commit len GitHub)
# roi dien thong tin database dung chung tren Azure SQL (Tho gui trong nhom chat).
#
# Chi can thiet khi ban chay profile "cloud":
#   mvn spring-boot:run -Dspring-boot.run.profiles=cloud
#
# Neu ket noi bao loi kieu "Cannot open server ... requested by the login. Client with IP
# address ... is not allowed to access the server" thi IP mang cua ban chua duoc mo firewall
# -> nhan Tho vao Azure Portal them IP cho ban (Networking -> Add your client IPv4 address).

cloud.db.server=ten-server-cua-nhom.database.windows.net
cloud.db.name=cinema_booking
cloud.db.username=ten_dang_nhap_duoc_cap
cloud.db.password=mat_khau_duoc_cap
