# Copy file này thành "application-secrets-cloud.properties" (cùng cấp, KHÔNG commit lên GitHub)
# rồi điền thông tin database dùng chung (Thọ gửi trong nhóm chat).
#
# Chỉ cần thiết khi bạn chạy profile "cloud":
#   mvn spring-boot:run -Dspring-boot.run.profiles=cloud

# ---- Bắt buộc ----
cloud.db.server=ten-server-cua-nhom
cloud.db.name=cinema_booking
cloud.db.username=ten_dang_nhap_duoc_cap
cloud.db.password=mat_khau_duoc_cap

# ---- Tuỳ chọn: chỉ sửa khi nhà cung cấp yêu cầu khác mặc định ----
# Cổng, mặc định 1433
#cloud.db.port=1433

# Tham số kết nối thêm. Mặc định đã là encrypt=true;trustServerCertificate=true,
# dùng được cho hầu hết nhà cung cấp. Riêng Azure SQL nếu muốn kiểm tra chứng chỉ
# chặt chẽ hơn thì đổi thành:
#cloud.db.options=encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net

# ---- Gặp lỗi kết nối thì xem lại ----
# "Cannot open server ... Client with IP address ... is not allowed to access the server"
#   -> IP mạng của bạn chưa được mở firewall. Nhắn Thọ thêm IP hiện tại của bạn vào
#      danh sách cho phép trên trang quản trị của nhà cung cấp.
# "The TCP/IP connection to the host ... has failed"
#   -> Kiểm tra lại cloud.db.server và cloud.db.port, và xem nhà cung cấp đã bật
#      cho phép kết nối từ xa (remote access) cho database này chưa.
